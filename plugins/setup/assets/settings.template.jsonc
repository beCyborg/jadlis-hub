// Базовый ~/.claude/settings.json — комментированный шаблон.
// Читать глазами, а вливать машинно: скилл /setup:workplace сливает
// settings.minimal.json (те же ключи без комментариев) через jq и показывает дифф.
// Твои существующие ключи слияние не трогает.
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  // Язык ответов. Claude Code пишет на нём и в терминале, и в десктопе.
  "language": "Russian",

  // 24-часовое время в интерфейсе вместо AM/PM.
  "timeFormat": "24-hour",

  // Модель думает перед каждым ответом, а не только по слову «think».
  // Дороже по токенам, заметно точнее на многошаговых задачах.
  "alwaysThinkingEnabled": true,

  // Память: уроки и поправки сохраняются между сессиями в ~/.claude/memory.
  // Без этого каждая новая сессия начинается с нуля.
  "autoMemoryEnabled": true,

  // Сколько усилий модель тратит на один ответ: low | medium | high | xhigh.
  // high — рабочий дефолт. xhigh ест недельную квоту заметно быстрее.
  "effortLevel": "high",

  // Тема интерфейса: auto | dark | light | dark-daltonized | light-daltonized.
  "theme": "auto",

  // Разрешения. defaultMode — как Claude Code спрашивает перед действием:
  //   default          — спрашивает перед записью файлов и командами (рекомендуется)
  //   acceptEdits      — правки файлов применяет молча, команды спрашивает
  //   plan             — только читает и предлагает план, ничего не меняет
  //   bypassPermissions — не спрашивает вообще; включать осознанно и не сразу
  "permissions": {
    "defaultMode": "default"
  },

  // Уведомление, когда Claude Code закончил и ждёт тебя.
  // Готовый вариант с человеческим текстом — плагин claude-notifications-go,
  // инструкция в assets/hooks/notify.md. Блок ниже — ручной минимум на один звук.
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff",
            "timeout": 5
          }
        ]
      }
    ]
  },

  // Строка состояния под полем ввода: папка, ветка git, процент контекста, модель.
  // Работает только в терминальном CLI — десктоп её не рисует.
  // Скрипт кладёт /setup:workplace из assets/statusline.sh.
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  }

  // ---- Опции, которых в базовом наборе нет. Раскомментируй, если нужно. ----

  // Закрепить модель за всеми сессиями. Без ключа модель выбирается в /model
  // и живёт до конца сессии.
  // "model": "opus",

  // Запасная модель, когда основная недоступна или упёрлась в лимит.
  // "fallbackModel": ["sonnet"],

  // Свой effort под конкретную модель — перекрывает effortLevel выше.
  // "modelSettings": { "claude-opus-5": { "effortLevel": "xhigh" } },

  // Сколько дней хранить транскрипты сессий (по умолчанию 30).
  // "cleanupPeriodDays": 90,

  // Разрешения без вопросов для команд, которые ты и так всегда разрешаешь.
  // Живёт внутри "permissions" выше, рядом с defaultMode.
  // "allow": ["Bash(ls *)", "Bash(git status *)", "Read(*)"],

  // Показывать краткие сводки размышлений модели.
  // "showThinkingSummaries": true,

  // Ключи API сюда НЕ писать: файл лежит в открытом виде и уезжает в бэкапы.
  // Ключи живут в Связке ключей macOS — стандарт описан в docs/2-verif.
}
