{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "Russian",
  "timeFormat": "24-hour",
  "alwaysThinkingEnabled": true,
  "autoMemoryEnabled": true,
  "effortLevel": "high",
  "theme": "auto",
  "permissions": {
    "defaultMode": "default"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  }
}
